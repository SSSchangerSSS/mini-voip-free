root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj}]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{conf,fa.md}]
# Asterisk config and Persian docs keep blank-line spacing readable
indent_size = 4

[Makefile]
indent_style = tab

[*.{ps1}]
indent_size = 4
