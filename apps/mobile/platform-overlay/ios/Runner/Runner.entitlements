<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- aps-environment is managed by Xcode automatic signing per build;
	     TestFlight/App Store builds resolve to production ([S09]). The employer's
	     Apple Team + bundle id (PREFLIGHT B2/B7) finalize this value. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
