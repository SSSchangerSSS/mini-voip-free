# mini-voip-free — non-secret site configuration template.
# Copy to deploy/site.env and fill in. NEVER put secrets here (they live in deploy/secrets/).
# This file is safe to store in config management; secrets are not.

# Public domain that resolves to this server (A record). Used for TLS, WSS and SIP realm.
SMI_DOMAIN=phone.example.invalid

# ACME account email for Let's Encrypt certificate notices.
SMI_ACME_EMAIL=ops@example.invalid

# RTP range — MUST match infra/asterisk/conf/rtp.conf and the host firewall.
SMI_RTP_START=10000
SMI_RTP_END=10199

# Call setup deadline in seconds (spec 4.2). Change only with a recorded decision.
SMI_SETUP_TIMEOUT_SECONDS=40

# Session / retention defaults (spec 4.2).
SMI_SESSION_IDLE_DAYS=90
SMI_DIAGNOSTIC_RETENTION_DAYS=7

# TURN stays disabled until the network gate proves it necessary (spec 2.4).
TURN_ENABLED=false
